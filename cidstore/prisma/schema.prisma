generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                 String              @id @default(cuid())
  email              String?             @unique
  name               String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  passwordHash       String?
  language           String              @default("id")
  phone              String?
  telegramUsername   String?
  telegramId         String?             @unique
  depositAddresses   DepositAddress[]
  orders             Order[]
  telegramLinkTokens TelegramLinkToken[]
  walletBalances     WalletBalance[]
  withdrawals        Withdrawal[]
}

model DepositAddress {
  id                  String               @id @default(cuid())
  userId              String
  asset               String
  network             String
  address             String?
  derivationIndex     Int?
  enabled             Boolean              @default(true)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  user                User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  depositTransactions DepositTransaction[]
  orders              Order[]

  @@unique([userId, asset, network])
}

model NetworkConfig {
  id              String   @id @default(cuid())
  asset           String
  network         String
  displayName     String
  explorerBaseUrl String?
  enabled         Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([asset, network])
}

model DepositTransaction {
  id                       String                   @id @default(cuid())
  depositAddressId         String
  orderId                  String?
  txHash                   String?
  asset                    String
  network                  String
  amount                   String?
  confirmations            Int?
  status                   DepositTransactionStatus @default(PENDING)
  detectedAt               DateTime?
  confirmedAt              DateTime?
  createdAt                DateTime                 @default(now())
  updatedAt                DateTime                 @updatedAt
  canonicalTxKey           String                   @unique
  provider                 String?
  providerAddressReference String?
  providerEventId          String?
  providerTransactionId    String?
  creditedAt               DateTime?
  depositEvents            DepositEvent[]
  depositAddress           DepositAddress           @relation(fields: [depositAddressId], references: [id], onDelete: Cascade)
  order                    Order?                   @relation(fields: [orderId], references: [id])

  @@index([providerTransactionId])
  @@index([txHash])
}

model DepositEvent {
  id                    String                   @id @default(cuid())
  depositTransactionId  String?
  provider              String
  providerEventId       String
  providerTransactionId String?
  txHash                String?
  status                DepositTransactionStatus
  processedAt           DateTime?
  rawEvent              Json?
  createdAt             DateTime                 @default(now())
  updatedAt             DateTime                 @updatedAt
  depositTransaction    DepositTransaction?      @relation(fields: [depositTransactionId], references: [id])

  @@unique([provider, providerEventId])
  @@index([depositTransactionId])
  @@index([providerTransactionId])
  @@index([txHash])
}

model Order {
  id                  String               @id
  type                OrderType
  crypto              String
  cryptoName          String
  network             String
  cryptoAmount        String
  fiatAmount          String
  fee                 String
  networkFee          String
  serviceFee          String
  paymentMethod       PaymentMethod
  walletAddress       String?
  total               String
  paymentProof        String?
  status              OrderStatus          @default(PENDING)
  paymentStatus       PaymentStatus?
  customerContact     String?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  paymentSubmittedAt  DateTime?
  verifiedAt          DateTime?
  adminNote           String?
  depositAddressId    String?
  userId              String?
  depositTransactions DepositTransaction[]
  depositAddress      DepositAddress?      @relation(fields: [depositAddressId], references: [id])
  user                User?                @relation(fields: [userId], references: [id])
}

model TelegramLinkToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Withdrawal {
  id            String           @id @default(cuid())
  userId        String
  asset         String
  network       String
  amount        Decimal          @db.Decimal(36, 18)
  fee           Decimal          @db.Decimal(36, 18)
  receiveAmount Decimal          @db.Decimal(36, 18)
  address       String
  status        WithdrawalStatus @default(PENDING)
  txHash        String?
  provider      String?
  processedAt   DateTime?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  user          User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

model WalletBalance {
  id        String   @id @default(cuid())
  userId    String
  asset     String
  network   String
  balance   Decimal  @default(0) @db.Decimal(36, 18)
  locked    Decimal  @default(0) @db.Decimal(36, 18)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, asset, network])
  @@index([userId])
}

enum OrderType {
  BUY
  SELL
}

enum PaymentMethod {
  QRIS
  DANA
}

enum OrderStatus {
  PENDING
  WAITING_VERIFICATION
  PAYMENT_VERIFIED
  PROCESSING
  COMPLETED
  CANCELLED
  REJECTED
  WAITING_CRYPTO
}

enum PaymentStatus {
  AWAITING_PAYMENT
  WAITING_VERIFICATION
  PAYMENT_VERIFIED
  AWAITING_CRYPTO
  REJECTED
}

enum DepositTransactionStatus {
  PENDING
  DETECTED
  CONFIRMED
  REJECTED
  CONFIRMING
  FAILED
  REORGED
  CREDITED
}

enum WithdrawalStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
}
